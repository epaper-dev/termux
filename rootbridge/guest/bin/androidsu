#!/usr/bin/env bash
# androidsu <command...> - run a command as real Android root via the
# termux-rootbridge daemon (outside proot).
#
# The daemon asks you in an Android dialog and runs the command only after you
# confirmed it there. androidsu just hands in the request and waits for the
# answer: no confirmation, no root.
#
# Environment: ROOTBRIDGE_DIR          bridge directory (default: see conf file)
#              ROOTBRIDGE_ACK_TIMEOUT  seconds to wait for the daemon to pick the request up (70)

# shellcheck source=../lib/rootbridge-guest-lib.sh
. "${ROOTBRIDGE_GUEST_LIB:-/usr/local/lib/termux-rootbridge/rootbridge-guest-lib.sh}" 2>/dev/null \
    || { echo "androidsu: rootbridge-guest-lib.sh nicht gefunden (install.sh erneut ausführen)" >&2; exit 1; }

BRIDGE_DIR="${ROOTBRIDGE_DIR:-$(conf_get BRIDGE_DIR || true)}"
BRIDGE_DIR="${BRIDGE_DIR:-/data/data/com.termux/files/home/.rootbridge}"
ACK_TIMEOUT="${ROOTBRIDGE_ACK_TIMEOUT:-70}"

if [ "$#" -eq 0 ]; then
    echo "Usage: androidsu <befehl>" >&2
    exit 2
fi
if [ ! -d "$BRIDGE_DIR" ]; then
    echo "androidsu: Bridge-Ordner $BRIDGE_DIR fehlt (Daemon in Termux starten: rootbridge start)" >&2
    exit 125
fi

cmd="$*"

id="$$_$(date +%s%N)"
req="$BRIDGE_DIR/req-$id.txt"
res="$BRIDGE_DIR/res-$id.txt"
ack="$BRIDGE_DIR/ack-$id"

printf '%s\n' "$cmd" > "$req"

cleanup() { rm -f "$req" "$ack"; }
trap cleanup EXIT
trap 'exit 130' INT TERM

# phase 1: wait for ack or result; phase 2: wait for the result without limit
tenths=0      # tenths of a second waited: every round sleeps 0.3 s
until [ -e "$res" ] || [ -e "$ack" ]; do
    sleep 0.3
    tenths=$(( tenths + 3 ))
    if [ "$tenths" -ge $(( ACK_TIMEOUT * 10 )) ]; then
        echo "androidsu: keine Antwort vom Root-Bridge-Daemon (läuft er? In Termux: rootbridge status)" >&2
        exit 124
    fi
done
until [ -e "$res" ]; do sleep 0.3; done

code="$(head -n 1 "$res")"
tail -n +2 "$res"
rm -f "$res"
exit "${code:-1}"
