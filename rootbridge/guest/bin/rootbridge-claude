#!/usr/bin/env bash
# rootbridge-claude - guest entry point (started by `rootbridge start`):
#   1. apt-get update + upgrade (rootbridge-apt, at most once every 6 h by default, never blocks the start)
#   2. rootbridge-update: claude update, codex update and the Codex plugin (CLAUDE_UPDATE / CODEX_UPDATE, at most
#      once every 6 h by default, never blocks the start). Starting Claude Code also updates Codex and the other way
#      round (rootbridge-codex does the same): the two review each other.
#   3. Claude Code with autonomous mode available
#
# The start mode comes from settings.json (the installer sets bypassPermissions with --autonomous yes);
# Shift+Tab switches between the modes, "bypass permissions" included, because
# --allow-dangerously-skip-permissions is set.
# Root-related commands are still confirmed by the android-root-guard hook.
# --continue (from `rootbridge theme` with THEME_RESTART=on) continues the last conversation.

export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/root/.local/bin:$PATH

CONF="${ROOTBRIDGE_CONF:-/etc/termux-rootbridge.conf}"
conf_get() {
    [ -r "$CONF" ] || return 1
    local v
    v="$(sed -n "s/^$1=//p" "$CONF" | tail -n 1)"
    v="${v%\"}"; v="${v#\"}"; v="${v%\'}"; v="${v#\'}"
    [ -n "$v" ] && printf '%s' "$v"
}

# Claude Code closes every file descriptor up to RLIMIT_NOFILE after each fork. Under proot every
# close() is a trapped syscall (~80 us), so Android's limit of 32768 costs 2.5-4 s per started process
# (hooks, Bash tool, rg, ...). Bun raises the soft limit back to the hard one, so both go down. Only
# ever lowered, and only for Claude (callers run this in a subshell); NOFILE_LIMIT=0 switches it off.
limit_nofile() {
    local n cur
    n="$(conf_get NOFILE_LIMIT || echo 2048)"
    case "$n" in ''|0|*[!0-9]*) return 0 ;; esac
    cur="$(ulimit -Hn)"
    case "$cur" in
        unlimited) ;;
        ''|*[!0-9]*) return 0 ;;
        *) [ "$cur" -gt "$n" ] || return 0 ;;
    esac
    ulimit -n "$n" 2>/dev/null || true
}

workdir="$(conf_get WORKDIR || echo /root/work)"
cd "$workdir" 2>/dev/null || cd /root || exit 1

export BROWSER=/usr/local/bin/rootbridge-open
export IS_SANDBOX=1          # Claude Code refuses bypass mode as root otherwise

claude_bin=/root/.local/bin/claude
[ -x "$claude_bin" ] || claude_bin="$(command -v claude || true)"
if [ -z "$claude_bin" ]; then
    echo "rootbridge-claude: claude nicht gefunden. Installation: curl -fsSL https://claude.ai/install.sh | bash" >&2
    exec bash -l
fi

if command -v rootbridge-apt >/dev/null 2>&1; then
    rootbridge-apt || true
fi

# claude update, codex update, Codex plugin (CLAUDE_UPDATE / CODEX_UPDATE, see rootbridge-update)
if command -v rootbridge-update >/dev/null 2>&1; then
    rootbridge-update || true
fi

# Emergency switch of the Codex pre-commit review hook: `rootbridge codex-off` (in Termux) puts
# CODEX_PRECOMMIT=off into the config, and the hook (a child of Claude Code) reads it from the environment.
# Only the value "off" is handed on.
[ "$(conf_get CODEX_PRECOMMIT || true)" = off ] && export CODEX_PRECOMMIT=off


# After Claude Code: a clean end (/exit = 0, Ctrl+C = 130) ends the script, so the tmux window and
# session close and the widget's Termux window closes too. On an error the shell stays open.
after_claude() {
    case "$1" in 0|130) exit 0 ;; esac
    echo
    echo "Claude Code wurde mit Code $1 beendet. Neu starten mit: claude   (Shell bleibt offen)"
    exec bash -l
}

has_claude_conversation() {
    python3 -I "${ROOTBRIDGE_CONVERSATION_CHECK:-/usr/local/lib/termux-rootbridge/claude-conversation.py}" \
        "${CLAUDE_CONFIG_DIR:-${HOME:-/root}/.claude}" "$PWD"
}

prepare_claude_args() {
    local arg new=0 skip_resume=0 continue_requested=0 auto_new=0
    extra=()
    case "${1:-}" in
        --new|-n) new=1 ;;
        --continue|-c|"") ;;
        *) echo "rootbridge-claude: unbekannte Option: $1" >&2; return 2 ;;
    esac
    local configured=()
    read -r -a configured <<< "$(conf_get CLAUDE_ARGS || true)"
    case "${1:-}" in --continue|-c) continue_requested=1 ;; esac
    for arg in "${configured[@]}"; do
        case "$arg" in --continue|-c) continue_requested=1 ;; esac
    done
    if [ "$new" = 0 ] && [ "$continue_requested" = 1 ] && ! has_claude_conversation; then
        auto_new=1
        echo "Keine gespeicherte Unterhaltung für $PWD gefunden - starte Claude neu." >&2
    fi
    for arg in "${configured[@]}"; do
        if [ "$auto_new" = 1 ]; then
            case "$arg" in --continue|-c) continue ;; esac
        fi
        if [ "$new" = 1 ]; then
            if [ "$skip_resume" = 1 ]; then
                skip_resume=0
                [[ "$arg" = -* ]] || continue
            fi
            case "$arg" in
                --continue|-c|--resume=*|--continue=*) continue ;;
                --resume|-r) skip_resume=1; continue ;;
            esac
        fi
        extra+=("$arg")
    done
    if [ "$new" = 0 ] && [ "$auto_new" = 0 ]; then
        case "${1:-}" in --continue|-c) extra+=(--continue) ;; esac
    fi
}
prepare_claude_args "${1:-}" || exit $?
( limit_nofile; exec "$claude_bin" --allow-dangerously-skip-permissions "${extra[@]}" )
after_claude "$?"
