#!/usr/bin/env bash
# rootbridge-codex - guest entry point of the Codex window (started by `rootbridge attach codex`, the widget "Codex"):
#   1. apt-get update + upgrade (rootbridge-apt, at most once every 6 h by default, never blocks the start)
#   2. rootbridge-update: claude update and codex update (CLAUDE_UPDATE / CODEX_UPDATE, at most
#      once every 6 h by default, never blocks the start). Starting Codex also updates Claude Code and the other
#      way round (rootbridge-claude does the same): the two review each other.
#   3. Codex, in the working directory, on with its last conversation there (codex resume --last)
#
# CODEX_ARGS in /etc/termux-rootbridge.conf adds options, for example CODEX_ARGS="--model gpt-5.5". By default the
# installer puts --dangerously-bypass-approvals-and-sandbox there (install.sh --codex-bypass, CODEX_BYPASS): under
# proot the bubblewrap sandbox of Codex fails on every command, so Codex would not run at all. Codex gets no Android
# root on its own: androidsu hands every request to the Termux daemon, which asks you in an Android dialog. The managed
# hook rootbridge-hook.py (/etc/codex/requirements.toml) tells Codex when you said no.

# (the tests set ROOTBRIDGE_CODEX_KEEP_PATH and ROOTBRIDGE_CODEX_BIN to run it with stubs)
[ -n "${ROOTBRIDGE_CODEX_KEEP_PATH:-}" ] || export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/root/.local/bin:$PATH

# shellcheck source=../lib/rootbridge-guest-lib.sh
. "${ROOTBRIDGE_GUEST_LIB:-/usr/local/lib/termux-rootbridge/rootbridge-guest-lib.sh}" 2>/dev/null \
    || { echo "rootbridge-codex: rootbridge-guest-lib.sh nicht gefunden (install.sh erneut ausführen)" >&2; exit 1; }

enter_workdir

# the browser hand-off for `codex login` (and links Codex opens): Android's browser, like for Claude Code
export BROWSER=/usr/local/bin/rootbridge-open

codex_bin="${ROOTBRIDGE_CODEX_BIN:-/root/.local/bin/codex}"
[ -x "$codex_bin" ] || codex_bin="$(command -v codex || true)"
if [ -z "$codex_bin" ]; then
    echo "rootbridge-codex: codex nicht gefunden. Installation: curl -fsSL https://chatgpt.com/codex/install.sh | sh" >&2
    exec bash -l
fi

# apt-get update + upgrade, claude update, codex update (APT_UPGRADE / CLAUDE_UPDATE / CODEX_UPDATE, see rootbridge-update)
run_maintenance

read -r -a extra <<< "$(conf_get CODEX_ARGS || true)"
# Codex goes on with the last conversation of this folder (as Claude Code does with --continue); the very first start has none
resume=()
compgen -G "${CODEX_HOME:-${HOME:-/root}/.codex}/sessions/*/*/*/rollout-*.jsonl" > /dev/null && resume=(resume --last)
( exec "$codex_bin" ${resume[@]+"${resume[@]}"} "${extra[@]}" )
after_tool Codex codex "$?"
