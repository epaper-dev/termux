{
  "extraKnownMarketplaces": {
    "openai-codex": {
      "source": {
        "source": "git",
        "url": "https://github.com/openai/codex-plugin-cc.git"
      },
      "autoUpdate": false
    }
  },
  "enabledPlugins": {
    "codex@openai-codex": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "@PYTHON@ -I @LIBDIR@/codex-precommit-review.py",
            "timeout": 900,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
