{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "@PYTHON@ -I @LIBDIR@/speak.py --hook",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "@PYTHON@ -I @LIBDIR@/speak.py --progress",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "@PYTHON@ -I @LIBDIR@/speak.py --command",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
