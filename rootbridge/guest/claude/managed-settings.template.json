{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "@PYTHON@ -I @LIBDIR@/rootbridge-hook.py",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "mcp__.*__(authenticate|complete_authentication)",
        "hooks": [
          {
            "type": "command",
            "command": "@PYTHON@ -I @LIBDIR@/auth-url-hook.py",
            "timeout": 40
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "@PYTHON@ -I @LIBDIR@/rootbridge-hook.py",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
