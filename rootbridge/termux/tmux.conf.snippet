# termux-root-bridge: clipboard hand-off. Claude Code's "c" key (login dialogs)
# copies links via OSC 52; tmux has to pass it on to Termux.
set -g mouse on
set -g set-clipboard on
set -gq allow-passthrough on
# termux-root-bridge: the Claude Code theme "Auto epaper" follows the light or dark
# mode of the phone (Termux reports it with DECSET 2031, tmux 3.6 or newer).
set-hook -g client-light-theme 'run-shell -b "rootbridge theme light"'
set-hook -g client-dark-theme 'run-shell -b "rootbridge theme dark"'
# termux-root-bridge: status line in the terminal colours (black on white / white on black) instead of
# black on green, readable on E-Ink also with Android's "High contrast text"; the active window in bold.
set -g status-style default
set -g window-status-current-style bold
