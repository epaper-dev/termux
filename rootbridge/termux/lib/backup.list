# backup.list - what `rootbridge backup` saves (installed next to rootbridge-backup.py). Your own lines go into backup.list
# next to the Termux config (~/.config/termux-rootbridge/backup.list), in the same form.
# A line: settings|secret termux|guest PATH (relative to the Termux home or to the root of the guest; * ? [] as in the
# shell), or: exclude termux|guest PATH. settings go into a.tgz, secrets into k.enc (encrypted with your password).

# --- Termux (@config: the active config, also with ROOTBRIDGE_CONFIG)
secret   termux @config
settings termux .config/termux-rootbridge/device.conf   # the keys of the device (devices/), read by the key readers
settings termux .termux/termux.properties
settings termux .ssh/authorized_keys
settings termux .termux/colors.properties

# --- the guest: rootbridge, git, Claude Code, Codex, OpenCode
settings guest  root/.claude/CLAUDE.md
settings guest  root/.claude/keybindings.json
settings guest  root/.claude/themes
settings guest  root/.claude/scripts      # for example the Codex pre-commit script
settings guest  root/.claude/commands
settings guest  root/.claude/agents
settings guest  root/.codex/AGENTS.md
settings guest  root/.local/state/opencode/model.json   # the model chosen in OpenCode

# --- secrets: logins of git, gh, Claude Code, Codex and OpenCode; their settings too, they can hold
# tokens (url rewrites, http headers, env, API keys)
secret   guest  root/.claude/projects/*/memory   # private session notes
secret   guest  root/.claude/plans               # private plans
secret   guest  etc/termux-rootbridge.conf   # CLAUDE_ARGS can hold tokens (--mcp-config)
secret   guest  root/.gitconfig
secret   guest  root/.claude/settings.json
secret   guest  root/.claude/settings.local.json
secret   guest  root/.codex/config.toml
secret   guest  root/.config/opencode     # opencode.json(c) can hold API keys; also AGENTS.md, agents, commands, skills, plugins, themes, cli.json
exclude  guest  root/.config/opencode/node_modules   # OpenCode installs the packages of its plugins itself (with these files)
exclude  guest  root/.config/opencode/package.json
exclude  guest  root/.config/opencode/package-lock.json
exclude  guest  root/.config/opencode/bun.lock
exclude  guest  root/.config/opencode/.gitignore
secret   guest  root/.git-credentials
secret   guest  root/.config/git/credentials
secret   guest  root/.config/git/config
secret   guest  root/.config/gh
secret   guest  root/.ssh                  # SSH keys, config and known hosts of the guest
# the plugins of Claude Code, so that they run again after a restore: what is installed and from where, their files and state,
# and whatever logins they keep. Not the copies of the marketplaces (plugins/marketplaces, about 100 MB): Claude Code loads
# them again from known_marketplaces.json.
secret   guest  root/.claude/plugins/installed_plugins.json
secret   guest  root/.claude/plugins/known_marketplaces.json
secret   guest  root/.claude/plugins/cache
secret   guest  root/.claude/plugins/data
secret   guest  root/.claude/plugins/store
secret   guest  root/.claude/.credentials.json
secret   guest  root/.claude.json
secret   guest  root/.codex/auth.json
secret   guest  root/.local/share/opencode/auth.json   # the logins of OpenCode (/connect)
secret   guest  root/.local/share/opencode/mcp-auth.json   # the OAuth logins of its MCP servers
secret   guest  root/.bashrc               # holds GITHUB_PERSONAL_ACCESS_TOKEN
secret   guest  root/.android             # adb keys
secret   guest  root/.local/share/rootbridge   # your voice for Articulino (voice.wav) or your "nie" to recording it
