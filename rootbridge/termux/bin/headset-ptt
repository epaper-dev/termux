#!/usr/bin/env python3
"""headset-ptt - the key of a wired headset as push to talk: `ptt toggle` on each long press (the first starts, the next
sends), nothing on release: the key of a wired headset shorts its microphone while it is held.

BRIDGE until the Termux app does this itself. It keeps a root `cat` on the buttons of the headset jack alive (the input
device whose name has "Button Jack", KEY_MEDIA; looked up as root at each start) and reads nothing else (keyreader.py).
Short and double presses are ignored: they stay with the music (play, pause). A long press also starts Android's voice
search, so no app should answer that (the A9 has none once Whisper is gone).

Installed by `install.sh` when the headset key is chosen (HEADSET=on in the rootbridge config) and started by
`rootbridge start|attach`. Runs in Termux as the Termux user; root is only the lookup and the `cat` (su).
Log: ~/.cache/headset-ptt.log      Stop it:  pkill -f headset-ptt
Test hooks: HEADSET_CMD, HEADSET_PTT, HEADSET_LONG, HEADSET_ONCE, HEADSET_CACHE (see keyreader.py).
"""
import os
import subprocess
import sys

HERE = os.path.dirname(os.path.realpath(__file__))
sys.path[:0] = [os.path.join(HERE, "..", "lib", "termux-rootbridge"), os.path.join(HERE, "..", "lib")]
import keyreader  # noqa: E402  (installed next to rootbridge-lib.sh, in the repository in termux/lib)

# the headset buttons, found by name (their event number depends on the kernel; apps may not read /sys/class/input)
# (exit 1 when the list cannot be read at all: the reader starts over; a phone without a jack finds nothing, exit 0)
FIND_HEADSET = ('ls /sys/class/input/event0 >/dev/null || exit 1; '
                'for d in /sys/class/input/event*; do case "$(cat "$d/device/name" 2>/dev/null)" in '
                '*"Button Jack"*) echo "/dev/input/${d##*/}" ;; esac; done')


class HeadsetKey(keyreader.Reader):
    name, prefix, key = "headset-ptt", "HEADSET", 226   # KEY_MEDIA

    def devices(self):
        try:
            r = subprocess.run(["su", "-c", FIND_HEADSET], stdin=subprocess.DEVNULL, capture_output=True, text=True,
                               timeout=20)
        except (OSError, subprocess.TimeoutExpired) as e:
            self.log("Headset-Suche fehlgeschlagen: %s" % e)
            return None
        if r.returncode != 0:
            self.log("Headset-Suche fehlgeschlagen: su Exit %d" % r.returncode)
            return None
        devices = [d for d in r.stdout.split() if d.startswith("/dev/input/event")]
        if not devices:
            self.log("keine Headset-Buchse gefunden")
            return None
        return devices

    def on_long(self, proc):
        # A recording started here is not ended when the reader ends: in tap mode (Claude Code's default here) a stop
        # is one more key press, and after the recording was ended by hand (Esc) or by Claude Code that press would
        # start a new one. ptt cannot tell (it only remembers its own start), and the reader ends rarely (reboot, a
        # failed su); a recording left running is ended by its next key.
        self.log("Headset-Taste lang: ptt toggle")
        self.ptt("toggle")


if __name__ == "__main__":
    sys.exit(HeadsetKey().main())
