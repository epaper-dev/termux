#!/usr/bin/env bash
# ptt - push to talk for a program in a tmux window (Claude Code /voice, or anything that listens for one key).
# Runs in Termux, needs no root.
#
#   ptt start     start talking (ends what rootbridge is reading aloud first)
#   ptt stop      stop talking (the text is taken over by the program)
#   ptt toggle    start, or stop when it was started by ptt
#   ptt status    "talking" or "idle"
#
# How it presses the key (PTT_MODE in the rootbridge config):
#   auto  (default)  the mode that Claude Code's /voice has (hold or tap), read from voice.mode in the settings
#                    of the guest; hold when it cannot be read. ptt and Claude Code then always agree: a
#                    repeater against a program in tap mode would toggle it with every press.
#   hold             `start` repeats the key every PTT_INTERVAL ms, like a key held down, until `stop`
#                    (or PTT_MAX seconds, in case `stop` never comes). Claude Code ends the recording when
#                    no key comes for 200 ms, so the repeater must never be late: one tmux client for all keys.
#                    When Claude Code ends the recording itself (its recorder `rec` is gone), the repeater stops
#                    instead of starting a new one; it also stops when no recorder starts (hold mode is for Claude Code).
#                    A recorder of Claude Code that still runs at `start` was left behind and would keep the sound
#                    from the new recording: `start` ends it first. `stop` looks again 3.5 s later (when no new start
#                    came), so a recorder left behind by the stop does not keep the microphone on until the next start.
#                    The repeats begin PTT_WARMUP ms after the first key: Claude Code starts its recorder with the first key
#                    (checks of sox, then rec), which blocks it for half a second or more on a phone, and its 200 ms release
#                    timer only starts with the second key. A second key into that stall ended the recording again and again
#                    ("listening" flickered). A program waits 2 s for the second key, so PTT_WARMUP stays below that.
#                    Claude Code: /voice hold
#   tap              `start` and `stop` press the key once each (the program's "tap to talk" mode); `toggle`
#                    presses once and leaves it to the program whether that starts or sends. ptt only
#                    remembers that it pressed `start`; when the program ended the recording by itself, a later
#                    `stop` starts a new one (limit of tap mode). Claude Code: /voice tap, the input has to be empty.
#
# Settings (~/.config/termux-rootbridge/config, read as data): PTT_TARGET (tmux target, default
# "<SESSION>:claude"), PTT_KEY (tmux key name, default M-k = Alt+K, the key that Claude Code's
# "voice:pushToTalk" is bound to in ~/.claude/keybindings.json), PTT_MODE, PTT_INTERVAL (ms), PTT_WARMUP (ms), PTT_MAX (s).
# PTT_BEEP (on/off): a short high beep when the recorder of Claude Code runs after `start` (the microphone is open,
# speak now) and a lower one when it ends (the recording is over); through PulseAudio (pacat).
# Test hook, from the environment only: PTT_PACAT (pacat binary), PTT_TMUX (tmux binary), PTT_STATE_DIR, PTT_CLAUDE_SETTINGS (settings file of Claude Code),
# PTT_PROC (/proc, where the recorder of Claude Code is looked for).

set -u

self="$(readlink -f "${BASH_SOURCE[0]}")"
here="${self%/*}"
lib=""
for cand in "${ROOTBRIDGE_LIB:-}" \
            "$here/../lib/termux-rootbridge/rootbridge-lib.sh" \
            "$here/../lib/rootbridge-lib.sh"; do
    if [ -n "$cand" ] && [ -r "$cand" ]; then lib="$cand"; break; fi
done
[ -n "$lib" ] || { echo "ptt: rootbridge-lib.sh nicht gefunden" >&2; exit 1; }
# shellcheck source=../lib/rootbridge-lib.sh
. "$lib"
rb_load_config

TMUX_BIN="${PTT_TMUX:-tmux}"
TARGET="${PTT_TARGET:-$SESSION:claude}"
STATE="${PTT_STATE_DIR:-$HOME/.cache/ptt}"
PIDFILE="$STATE/hold.pid"
FLAG="$STATE/tap.flag"
KEYS_END="$STATE/hold.end"   # written when the repeater stops sending keys (stop, or its own end)
SESSION_RECS="$STATE/hold.recs"   # the recorders that started in the session, written by `stop`
SESSION_OLD="$STATE/hold.old"     # the recorders that ran before the session, written by the repeater at its start
PROC="${PTT_PROC:-/proc}"
PACAT="${PTT_PACAT:-pacat}"
BEEP_TOKEN="$STATE/beep.token"   # the start whose watcher may beep (an older watcher would see the same recorder)

usage() { awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$self"; }

press() { "$TMUX_BIN" send-keys -t "$TARGET" "$PTT_KEY" 2>/dev/null; }

# claude_voice_mode: hold or tap, the voice.mode of Claude Code in the guest (the same machine, so ptt reads the file)
claude_voice_mode() {
    local cand f=""
    for cand in "${PREFIX:-}/var/lib/proot-distro/containers/$DISTRO/rootfs" "${PREFIX:-}/var/lib/proot-distro/installed-rootfs/$DISTRO"; do
        if [ -d "$cand" ]; then f="$cand/root/.claude/settings.json"; break; fi
    done
    f="${PTT_CLAUDE_SETTINGS:-$f}"
    python3 -I - "$f" 2>/dev/null <<'PYMODE' || echo hold
import json, sys
try:
    mode = json.load(open(sys.argv[1], encoding="utf-8")).get("voice", {}).get("mode")
except (OSError, ValueError, AttributeError):
    mode = None
print(mode if mode in ("hold", "tap") else "hold")
PYMODE
}
if [ "$PTT_MODE" = auto ]; then MODE="$(claude_voice_mode)"; else MODE="$PTT_MODE"; fi
case "$MODE" in hold|tap) ;; *) MODE=hold ;; esac

# Hold mode: the file $PIDFILE holds the token of the running repeater. `stop` removes it, a newer `start` replaces
# it; the repeater ends when its token is gone. No pid is needed, so there is no race between starting the loop and
# writing the file, and a killed repeater leaves a file that goes stale after PTT_MAX seconds.
# Claude Code takes the key for released when none comes for 200 ms, so the repeater talks to tmux through one client
# in control mode (`tmux -C`), started once: a round starts no process (a process per key took up to 220 ms under
# proot). Without a control client (an old tmux) each key is one `tmux` process.
# When Claude Code has ended the recording itself (Esc, a stall), one more key would start a new recording right into
# the start of its recorder, which is the flicker. Claude Code records with SoX (`rec ... --buffer 1024 -t raw ...`) and
# ends that process with the recording; the screen is no use here, it shows the end only some 50 ms later. So after
# the warmup the repeater looks for the recorder that is new since its start, and before every key it checks that
# this recorder still runs; when it is gone, or none comes within PTT_WARMUP + 2 s, the repeater stops. Left open: a key
# that is already on its way when Claude Code ends the recording (Esc takes it some 150 ms) starts a new one, which
# ends again at once without more keys.
# The pause is `read -t` on a fifo that never gets data (not `<(:)`: under proot a read on that returns at once).

# end_left_recorders: before ptt starts a recording in hold mode it is idle, so no recording of Claude Code should run in the
# target window. A recorder that still runs there was left behind by Claude Code (a superseded start,
# anthropics/claude-code#110732) and keeps the sound: PulseAudio in Termux gave it to that one client, and every new
# recording got silence ("listening", no text). Only recorders below the pane process of the target window are ended
# (a recording in another session stays); without that window nothing is ended. Proof that a recorder is left: in hold
# mode a recording lives only while keys come (Claude Code ends it 200 ms after the last one), so when ptt sent its last
# key at least 3 s ago, no recording can be in use. A quick stop and start (Claude Code may still be ending the recording
# of the stop) ends nothing.
session_recorders() {   # the running recorders that were not there when the repeater started (hold.old)
    local p old
    [ -r "$SESSION_OLD" ] || return 0   # without the baseline of a session no recorder counts as its own
    old=" $(tr '\n' ' ' < "$SESSION_OLD")"
    rb_find_recorders "$PROC"
    for p in "${REC_PIDS[@]}"; do [[ $old == *" $p "* ]] || printf '%s\n' "$p"; done
}

# end_left_recorders [pid...]: with pids, only those of them that still are recorders (the ones of a stopped session).
end_left_recorders() {
    local p pane age
    if age="$(file_age "$KEYS_END")" && [ "$age" -lt 3 ]; then return 0; fi
    rb_find_recorders "$PROC"
    [ "${#REC_PIDS[@]}" -gt 0 ] || return 0
    pane="$("$TMUX_BIN" display-message -p -t "$TARGET" '#{pane_pid}' 2>/dev/null)" || return 0
    [[ $pane =~ ^[0-9]+$ ]] || return 0
    for p in "${REC_PIDS[@]}"; do
        if [ $# -gt 0 ] && [[ " $* " != *" $p "* ]]; then continue; fi
        if under_pane "$p" "$pane"; then kill -TERM "$p" 2>/dev/null; fi
    done
}

under_pane() {   # under_pane <pid> <pane pid>: the pane process is an ancestor of the process (read from $PROC/*/stat)
    local pid="$1" st
    for _ in {1..40}; do   # at most 40 steps up
        [ "$pid" = "$2" ] && return 0
        [ "$pid" -gt 1 ] 2>/dev/null || return 1
        { st="$(< "$PROC/$pid/stat")"; } 2>/dev/null || return 1
        st="${st##*) }"           # the name in brackets may hold spaces; then: state, ppid
        pid="${st#* }"; pid="${pid%% *}"
    done
    return 1
}

tm_open() {   # start the control client and skip everything it says before the answer to our first command
    local line
    coproc TM { exec "$TMUX_BIN" -C attach-session -t "$TARGET" -f ignore-size,no-output 2>/dev/null; }
    printf 'display-message -p ptt-ready\n' 1>&"${TM[1]}" 2>/dev/null || return 1
    while :; do IFS= read -r -t 3 -u "${TM[0]}" line || return 1; [ "$line" = ptt-ready ] && break; done
    while :; do IFS= read -r -t 3 -u "${TM[0]}" line || return 1; [[ $line == %end* ]] && return 0; done
}

tm() {   # tm <tmux command>: run it through the control client and wait for its end
    local line
    printf '%s\n' "$1" 1>&"${TM[1]}" 2>/dev/null || return 1
    while :; do
        IFS= read -r -t 2 -u "${TM[0]}" line || return 1
        case "$line" in %end*) return 0 ;; %error*) return 1 ;; esac
    done
}

hold_loop() {   # hold_loop <token>
    local token="$1" end=$((SECONDS + PTT_MAX)) delay cur ctl=0 rec="" old p st nap="$STATE/nap.$BASHPID.$RANDOM"
    local rec_deadline=$((SECONDS + PTT_WARMUP / 1000 + 3))   # SECONDS counts whole seconds: about warmup + 2 s
    trap '' PIPE                                                # a control client that is gone must not end the loop
    delay="$(printf '%d.%03d' $((PTT_INTERVAL / 1000)) $((PTT_INTERVAL % 1000)))"
    rb_find_recorders "$PROC"; old=" ${REC_PIDS[*]} "
    printf '%s\n' "${REC_PIDS[@]}" > "$SESSION_OLD"
    mkfifo "$nap" || return 0
    exec 3<> "$nap"
    rm -f "$nap"
    tm_open && ctl=1
    read -r -t "$(printf '%d.%03d' $((PTT_WARMUP / 1000)) $((PTT_WARMUP % 1000)))" -u 3 _ || true   # the first key was pressed by do_start
    while [ "$SECONDS" -lt "$end" ]; do
        cur=""; read -r cur < "$PIDFILE" 2>/dev/null || true
        [ "$cur" = "$token" ] || break
        if [ -z "$rec" ]; then
            rb_find_recorders "$PROC"
            for p in "${REC_PIDS[@]}"; do [[ $old == *" $p "* ]] || rec="$p"; done
            if [ -z "$rec" ] && [ "$SECONDS" -ge "$rec_deadline" ]; then break; fi   # Claude Code does not record
        else
            # Claude Code ended the recording when its recorder is gone, a zombie (not reaped yet), or has a signal pending
            # (field 31: the SIGTERM of Claude Code, seen before the recorder has ended)
            st=(); read -r -a st < "$PROC/$rec/stat" 2>/dev/null || true
            case "${st[2]:-}" in ''|Z|X) break ;; esac
            if [ "${st[30]:-0}" != 0 ]; then break; fi
        fi
        if [ "$ctl" = 1 ]; then tm "send-keys -t $TARGET $PTT_KEY" || break; else press || break; fi
        read -r -t "$delay" -u 3 _ || true
    done
    if [ -n "${TM_PID:-}" ]; then kill "$TM_PID" 2>/dev/null; fi
    cur=""; read -r cur < "$PIDFILE" 2>/dev/null || true
    # ended by itself (recorder gone, no recorder, PTT_MAX): its last key is now. Ended by `stop`: that wrote the time, and
    # no key went out after it (the token is checked before every key; during the warmup the loop only waits)
    if [ "$cur" = "$token" ]; then rm -f "$PIDFILE"; : > "$KEYS_END"; fi
    return 0
}

# tone <period> <count>: a short tone through PulseAudio, <count> times one period of 16-bit samples at 8 kHz; a failure
# (no pacat, no PulseAudio, a timeout) goes to beep.log in the state directory, the recording does not depend on it
tone() {
    local n err
    err="$( { for ((n = 0; n < $2; n++)); do printf '%b' "$1"; done \
        | timeout 3 "$PACAT" --raw --format=s16le --rate=8000 --channels=1 >/dev/null; } 2>&1 )" && return 0
    printf '%s Ton nicht abgespielt (%s): %s\n' "$(date '+%F %T')" "$PACAT" "${err:-Timeout}" >> "$STATE/beep.log" 2>/dev/null
    return 0
}
HIGH='\x00\x00\xc7\x0d\x4a\x16\x4a\x16\xc7\x0d\x00\x00\x39\xf2\xb6\xe9\xb6\xe9\x39\xf2'   # 800 Hz
LOW='\x00\x00\x3e\x07\xc7\x0d\xf6\x12\x4a\x16\x70\x17\x4a\x16\xf6\x12\xc7\x0d\x3e\x07\x00\x00\xc2\xf8\x39\xf2\x0a\xed\xb6\xe9\x90\xe8\xb6\xe9\x0a\xed\x39\xf2\xc2\xf8'   # 400 Hz

# beep_when_listening <token> <recorder pid...>: waits up to 4 s for a recorder of Claude Code that is not one of these
# (the ones that ran before the key), then, while <token> is still that of the newest start, beeps high (0.12 s): it runs and has opened the microphone through PulseAudio
# by now, so one can speak. When that recorder ends (ptt stop, or Claude Code ended the recording), a lower, longer
# tone (0.2 s): the recording is over.
beep_when_listening() {
    local token="$1" pid i j
    shift
    local old=" $* "
    for ((i = 0; i < 40; i++)); do
        rb_find_recorders "$PROC"
        for pid in "${REC_PIDS[@]}"; do
            [[ "$old" == *" $pid "* ]] && continue
            sleep 0.3
            [ "$(cat "$BEEP_TOKEN" 2>/dev/null)" = "$token" ] || return 0
            [ -e "$PROC/$pid/cmdline" ] || return 0   # it ended in the wait: nothing is recorded, no "speak now"
            tone "$HIGH" 96
            for ((j = 0; j < (PTT_MAX + 10) * 5; j++)); do
                [ -e "$PROC/$pid/cmdline" ] || break
                sleep 0.2
            done
            # only when it really ended (not at the deadline) and no newer start took over
            [ ! -e "$PROC/$pid/cmdline" ] && [ "$(cat "$BEEP_TOKEN" 2>/dev/null)" = "$token" ] && tone "$LOW" 80
            return 0
        done
        sleep 0.1
    done
}

# watch_recording <recorder pid...>: with PTT_BEEP=on, makes this start the newest (beep.token) and lets
# beep_when_listening wait for its recorder in the background
watch_recording() {
    [ "$PTT_BEEP" = on ] || return 0
    local token="$$.$RANDOM.$SECONDS"
    mkdir -p "$STATE"
    printf '%s\n' "$token" > "$BEEP_TOKEN"
    ( beep_when_listening "$token" "$@" ) </dev/null >/dev/null 2>&1 &
    disown 2>/dev/null || true
}

file_age() {   # seconds since the file was written, or fails
    local m now
    m="$(stat -c %Y "$1" 2>/dev/null)" || return 1
    now="$(date +%s)"
    [[ "$m" =~ ^[0-9]+$ ]] || return 1
    echo $((now - m))
}

hold_alive() {
    local age
    age="$(file_age "$PIDFILE")" || return 1
    [ "$age" -le $((PTT_MAX + 2)) ]
}

tap_active() {
    local age
    age="$(file_age "$FLAG")" || return 1
    [ "$age" -le "$PTT_MAX" ]
}

active() {
    if [ "$MODE" = hold ]; then hold_alive; else tap_active; fi
}

do_start() {
    rb_speak_stop                # the microphone would record what is being read aloud
    mkdir -p "$STATE"
    active && return 0
    if [ "$MODE" = hold ]; then end_left_recorders; rm -f "$SESSION_RECS" "$SESSION_OLD"; fi   # tap: a recording started by hand may run, the press ends it
    rb_find_recorders "$PROC"
    local before=("${REC_PIDS[@]}")
    press || return 0            # no such window: nothing to do
    watch_recording "${before[@]}"
    if [ "$MODE" = hold ]; then
        local token="$$.$RANDOM.$SECONDS"
        printf '%s\n' "$token" > "$PIDFILE"
        ( hold_loop "$token" ) </dev/null >/dev/null 2>&1 &
        disown 2>/dev/null || true
    else
        : > "$FLAG"
    fi
}

do_stop() {
    if [ "$MODE" = hold ]; then
        hold_alive && [ -r "$SESSION_OLD" ] || { rm -f "$PIDFILE"; return 0; }   # no session of ptt: nothing to look after
        rm -f "$PIDFILE"         # the repeater sees this at its next round and ends
        : > "$KEYS_END"
        # a recorder of this session that Claude Code leaves behind at this stop would keep the microphone on: once no key
        # came for 3 s (and no new start), end it. Only the recorders new since the session started, as they are at this
        # stop (hold.recs): a recording started by hand (Alt+K) after the stop stays.
        session_recorders > "$SESSION_RECS"
        ( sleep 3.5; active && exit 0
          mapfile -t recs < "$SESSION_RECS" 2>/dev/null || exit 0
          [ "${#recs[@]}" -gt 0 ] && end_left_recorders "${recs[@]}" ) </dev/null >/dev/null 2>&1 &
        disown 2>/dev/null || true
    else
        tap_active && press
        rm -f "$FLAG"
    fi
    return 0
}

# toggle: in hold mode ptt knows whether it is talking (it is the one that repeats); in tap mode the program knows (it may
# have ended the recording by itself), so one press is all it does, and the program starts or sends
do_toggle() {
    rb_speak_stop                # also in tap mode, where toggle does not go through do_start
    if [ "$MODE" = tap ]; then
        rb_find_recorders "$PROC"
        local before=("${REC_PIDS[@]}")
        press || return 0
        # no recorder ran: this press starts one (else it sends, and the watcher of that recording beeps its end)
        [ "${#before[@]}" -gt 0 ] || watch_recording
        if tap_active; then rm -f "$FLAG"; else mkdir -p "$STATE"; : > "$FLAG"; fi
    elif active; then
        do_stop
    else
        do_start
    fi
}

case "${1:-}" in
    start)  do_start ;;
    stop)   do_stop ;;
    toggle) do_toggle ;;
    status) if active; then echo talking; else echo idle; fi ;;
    -h|--help|help|'') usage ;;
    *) echo "ptt: unbekannter Befehl: $1 (start | stop | toggle | status)" >&2; exit 2 ;;
esac
