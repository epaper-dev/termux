#!/usr/bin/env bash
# ptt - push to talk for a program in a tmux window (Claude Code /voice, or anything that listens for one key).
# Runs in Termux, needs no root.
#
#   ptt start     start talking
#   ptt stop      stop talking (the text is taken over by the program)
#   ptt toggle    start, or stop when it was started by ptt
#   ptt status    "talking" or "idle"
#
# How it presses the key (PTT_MODE in the rootbridge config):
#   hold  (default)  `start` repeats the key every PTT_INTERVAL ms, like a key held down, until `stop`
#                    (or PTT_MAX seconds, in case `stop` never comes). The program's own "hold to talk" mode
#                    ends the recording when the repeats stop, so there is no silence timeout in between.
#                    Claude Code: /voice hold
#   tap              `start` and `stop` press the key once each (the program's "tap to talk" mode). ptt only
#                    remembers that it pressed `start`; when the program ended the recording by itself, a later
#                    `stop` starts a new one (limit of tap mode, hence the default hold).
#
# Settings (~/.config/termux-rootbridge/config, read as data): PTT_TARGET (tmux target, default
# "<SESSION>:claude"), PTT_KEY (tmux key name, default M-k = Alt+K, the key that Claude Code's
# "voice:pushToTalk" is bound to in ~/.claude/keybindings.json), PTT_MODE, PTT_INTERVAL (ms), PTT_MAX (s).
# Test hook, from the environment only: PTT_TMUX (tmux binary), PTT_STATE_DIR.

set -u

self="$(readlink -f "${BASH_SOURCE[0]}")"
here="${self%/*}"
lib=""
for cand in "${ROOTBRIDGE_LIB:-}" \
            "$here/../lib/termux-rootbridge/rootbridge-lib.sh" \
            "$here/../lib/rootbridge-lib.sh"; do
    if [ -n "$cand" ] && [ -r "$cand" ]; then lib="$cand"; break; fi
done
[ -n "$lib" ] || { echo "ptt: rootbridge-lib.sh nicht gefunden" >&2; exit 1; }
# shellcheck source=../lib/rootbridge-lib.sh
. "$lib"
rb_load_config

TMUX_BIN="${PTT_TMUX:-tmux}"
TARGET="${PTT_TARGET:-$SESSION:claude}"
STATE="${PTT_STATE_DIR:-$HOME/.cache/ptt}"
PIDFILE="$STATE/hold.pid"
FLAG="$STATE/tap.flag"

usage() { awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$self"; }

press() { "$TMUX_BIN" send-keys -t "$TARGET" "$PTT_KEY" 2>/dev/null; }

# Hold mode: the file $PIDFILE holds the token of the running repeater. `stop` removes it, a newer `start` replaces
# it; the repeater ends when its token is gone. No pid is needed, so there is no race between starting the loop and
# writing the file, and a killed repeater leaves a file that goes stale after PTT_MAX seconds.
hold_loop() {   # hold_loop <token>
    local token="$1" end=$((SECONDS + PTT_MAX)) delay
    delay="$(printf '%d.%03d' $((PTT_INTERVAL / 1000)) $((PTT_INTERVAL % 1000)))"
    while [ "$SECONDS" -lt "$end" ] && [ "$(cat "$PIDFILE" 2>/dev/null)" = "$token" ]; do
        press || break
        sleep "$delay"
    done
    if [ "$(cat "$PIDFILE" 2>/dev/null)" = "$token" ]; then rm -f "$PIDFILE"; fi
    return 0
}

file_age() {   # seconds since the file was written, or fails
    local m now
    m="$(stat -c %Y "$1" 2>/dev/null)" || return 1
    now="$(date +%s)"
    [[ "$m" =~ ^[0-9]+$ ]] || return 1
    echo $((now - m))
}

hold_alive() {
    local age
    age="$(file_age "$PIDFILE")" || return 1
    [ "$age" -le $((PTT_MAX + 2)) ]
}

tap_active() {
    local age
    age="$(file_age "$FLAG")" || return 1
    [ "$age" -le "$PTT_MAX" ]
}

active() {
    if [ "$PTT_MODE" = hold ]; then hold_alive; else tap_active; fi
}

do_start() {
    mkdir -p "$STATE"
    active && return 0
    press || return 0            # no such window: nothing to do
    if [ "$PTT_MODE" = hold ]; then
        local token="$$.$RANDOM.$SECONDS"
        printf '%s\n' "$token" > "$PIDFILE"
        ( hold_loop "$token" ) </dev/null >/dev/null 2>&1 &
        disown 2>/dev/null || true
    else
        : > "$FLAG"
    fi
}

do_stop() {
    if [ "$PTT_MODE" = hold ]; then
        rm -f "$PIDFILE"         # the repeater sees this at its next round and ends
    else
        tap_active && press
        rm -f "$FLAG"
    fi
    return 0
}

case "${1:-}" in
    start)  do_start ;;
    stop)   do_stop ;;
    toggle) if active; then do_stop; else do_start; fi ;;
    status) if active; then echo talking; else echo idle; fi ;;
    -h|--help|help|'') usage ;;
    *) echo "ptt: unbekannter Befehl: $1 (start | stop | toggle | status)" >&2; exit 2 ;;
esac
