#!/usr/bin/env python3
"""sidekey-ptt - side key of the Hisense A9 and the key of a wired headset (long press) as push to talk. Side key: `ptt
start` on the long press, `ptt stop` on release. Headset key: `ptt toggle` on each long press (the first starts, the
next sends), nothing on release: the key of a wired headset shorts its microphone while it is held.

BRIDGE until the E-Ink app (hisense-a9/patching) and the Termux app do this themselves. It keeps a root `cat` on
/dev/input/event2 (gpio-keys, scan code 766 = 0x2fe) and one on the buttons of the headset jack (the input device whose
name has "Button Jack", KEY_MEDIA; looked up as root at each start) alive and reads nothing else. Each is a `su` of its
own: Magisk ends a `su -c` at once when its shell starts readers in the background. When one ends, the reader ends
the others and starts over. Short and double presses are ignored: they stay with
the E-Ink app, and with the music (play, pause). Set the long press of the E-Ink app to "Nothing", or its menu opens as
well; a long press on the headset key also starts Android's voice search, so no app should answer that (the A9 has
none once Whisper is gone).

Installed by `install.sh --sidekey` (SIDEKEY=on in the rootbridge config) and started by `rootbridge start|attach`.
Runs in Termux as the Termux user; root is only the `cat` (su). One instance (flock). Log: ~/.cache/sidekey-ptt.log
Stop it:  pkill -f sidekey-ptt        (a stray `cat` ends with the next key press)

Test hooks (environment): SIDEKEY_CMD (event sources instead of su, one command per line; each prints the pid of
its reader on the first line, which is then ended without su), SIDEKEY_PTT (ptt binary), SIDEKEY_LONG (seconds),
SIDEKEY_ONCE=1 (leave at the end of the event stream), SIDEKEY_CACHE (log and lock directory).
"""
import fcntl
import os
import select
import shlex
import signal
import struct
import subprocess
import sys
import time

HOME = os.path.expanduser("~")
CACHE = os.environ.get("SIDEKEY_CACHE", os.path.join(HOME, ".cache"))
LOG = os.path.join(CACHE, "sidekey-ptt.log")
LOCK = os.path.join(CACHE, "sidekey-ptt.lock")
DEV = "/dev/input/event2"
SCAN = 766                                           # KEY 0x2fe
KEY_MEDIA = 226                                      # the key of a headset
KEYS = {SCAN, KEY_MEDIA}
# the headset buttons, found by name (their event number depends on the kernel; apps may not read /sys/class/input)
# (exit 1 when the list cannot be read at all: the reader starts over; a phone without a jack finds nothing, exit 0)
FIND_HEADSET = ('ls /sys/class/input/event0 >/dev/null || exit 1; '
                'for d in /sys/class/input/event*; do case "$(cat "$d/device/name" 2>/dev/null)" in '
                '*"Button Jack"*) echo "/dev/input/${d##*/}" ;; esac; done')
LONG = float(os.environ.get("SIDEKEY_LONG", "0.4"))  # Android's long press timeout (settings: long_press_timeout 400)
PTT = os.environ.get("SIDEKEY_PTT", "ptt")
TEST_CMDS = [shlex.split(line) for line in os.environ.get("SIDEKEY_CMD", "").splitlines() if line.strip()]
ONCE = os.environ.get("SIDEKEY_ONCE") == "1"
EVENT = struct.Struct("<qqHHi")                      # struct input_event on 64 bit: time (2 x 8), type, code, value
EV_KEY = 1

procs = []
talking = False


def log(msg):
    try:
        if os.path.exists(LOG) and os.path.getsize(LOG) > 200_000:
            os.replace(LOG, LOG + ".1")
        with open(LOG, "a") as f:
            f.write("%s %s\n" % (time.strftime("%Y-%m-%d %H:%M:%S"), msg))
    except OSError:
        pass


def ptt(action):
    try:
        r = subprocess.run([PTT, action], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                           stderr=subprocess.DEVNULL, timeout=5)
        if r.returncode != 0:
            log("ptt %s: Exit %d" % (action, r.returncode))
    except (OSError, subprocess.TimeoutExpired) as e:
        log("ptt %s: %s" % (action, e))


def release():
    global talking
    if talking:
        talking = False
        ptt("stop")


def shutdown(signum, _frame):
    log("beendet (Signal %d)" % signum)
    release()
    stop_all([])
    sys.exit(0)


def sources():
    """The commands that read the keys: a root `cat` of the side key and of each headset jack; None when the root lookup
    of the headset failed (the reader starts over, as when a stream ends)."""
    if TEST_CMDS:
        return TEST_CMDS
    try:
        r = subprocess.run(["su", "-c", FIND_HEADSET], stdin=subprocess.DEVNULL, capture_output=True, text=True,
                           timeout=20)
    except (OSError, subprocess.TimeoutExpired) as e:
        log("Headset-Suche fehlgeschlagen: %s" % e)
        return None
    if r.returncode != 0:
        log("Headset-Suche fehlgeschlagen: su Exit %d" % r.returncode)
        return None
    devices = [DEV] + [d for d in r.stdout.split() if d.startswith("/dev/input/event") and d != DEV]
    # the root pid first: ending the su client leaves Magisk's `cat` waiting on a quiet device, so it is ended by pid
    return [["su", "-c", "echo $$; exec cat " + d] for d in devices]


def stop_all(readers):
    """End the su clients and their root readers (by the pids they printed first)."""
    for p in procs:
        try:
            p.kill()
            p.wait(timeout=2)
        except (OSError, subprocess.TimeoutExpired):
            pass
    procs.clear()
    if not readers:
        return
    if TEST_CMDS:
        for pid in readers:
            try:
                os.kill(pid, signal.SIGKILL)
            except OSError:
                pass
        return
    # kills only a pid that is still a `cat` of an input device (a reader that already ended may have passed its pid on),
    # and prints each one that is still there after its kill
    script = ('for p in %s; do case "$(tr "\\0" " " < /proc/$p/cmdline 2>/dev/null)" in '
              '"cat /dev/input/event"*) kill $p 2>/dev/null || [ ! -d /proc/$p ] || echo $p ;; esac; done'
              % " ".join(map(str, readers)))
    try:
        r = subprocess.run(["su", "-c", script], stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=20)
    except (OSError, subprocess.TimeoutExpired) as e:
        log("Root-Leser %s nicht beendet: %s" % (readers, e))
        return
    if r.returncode != 0 or r.stdout.strip():
        log("Root-Leser nicht beendet: %s (su Exit %d)" % (r.stdout.split() or readers, r.returncode))


def run_once():
    """Read the event streams until one of them ends; returns how many seconds that lasted."""
    global talking
    t_start = time.monotonic()
    cmds = sources()
    if cmds is None:
        return 0.0
    log("liest: %s" % ", ".join(cmd[-1] for cmd in cmds))
    for cmd in cmds:
        procs.append(subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, stdin=subprocess.DEVNULL))
    bufs = {p.stdout.fileno(): b"" for p in procs}
    readers = {}                     # fd: the pid of its root reader, from the first line
    down = None                      # monotonic time of the press that is still held
    held = None                      # its key
    long_done = False                # its long press was taken
    while True:
        wait = None
        if down is not None and not long_done:
            wait = max(0.0, down + LONG - time.monotonic())
        ready, _, _ = select.select(list(bufs), [], [], wait)
        now = time.monotonic()
        if down is not None and not long_done and now >= down + LONG:
            long_done = True
            if held == KEY_MEDIA:
                # A recording started here is not ended when the reader ends: in tap mode (Claude Code's default
                # here) a stop is one more key press, and after the recording was ended by hand (Esc) or by Claude
                # Code that press would start a new one. ptt cannot tell (it only remembers its own start), and
                # the reader ends rarely (reboot, a failed su); a recording left running is ended by its next key.
                log("Headset-Taste lang: ptt toggle")
                ptt("toggle")
            else:
                talking = True
                log("Langdruck: ptt start")
                ptt("start")
        ended = False
        for fd in ready:
            chunk = os.read(fd, 4096)
            if not chunk:
                ended = True
                break
            buf = bufs[fd] + chunk
            if fd not in readers:
                line, newline, rest = buf.partition(b"\n")
                if not newline:
                    bufs[fd] = buf
                    continue
                readers[fd] = int(line) if line.strip().isdigit() else 0
                buf = rest
            while len(buf) >= EVENT.size:
                _, _, etype, code, value = EVENT.unpack(buf[:EVENT.size])
                buf = buf[EVENT.size:]
                if etype != EV_KEY or code not in KEYS:
                    continue
                if value == 1 and down is None:
                    down, held = time.monotonic(), code
                elif value == 0 and code == held:
                    if talking:
                        log("losgelassen: ptt stop")
                        release()
                    down, long_done = None, False
            bufs[fd] = buf
        if ended:
            break
    release()
    # the pids of readers whose first line was not read yet (another stream ended first)
    for fd in set(bufs) - set(readers):
        buf = bufs[fd]
        while b"\n" not in buf and select.select([fd], [], [], 1)[0]:
            chunk = os.read(fd, 4096)
            if not chunk:
                break
            buf += chunk
        line = buf.partition(b"\n")[0]
        readers[fd] = int(line) if b"\n" in buf and line.strip().isdigit() else 0
    stop_all([pid for pid in readers.values() if pid > 1])
    return time.monotonic() - t_start


def main():
    os.makedirs(CACHE, exist_ok=True)
    lock = open(LOCK, "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        print("sidekey-ptt laeuft schon", file=sys.stderr)
        return 0
    signal.signal(signal.SIGTERM, shutdown)
    signal.signal(signal.SIGINT, shutdown)
    log("gestartet")
    delay = 2
    while True:
        lasted = run_once()
        if ONCE:
            return 0
        log("Ereignisstrom endete nach %.0f s (su verweigert, oder cat beendet), neuer Versuch in %d s" % (lasted, delay))
        time.sleep(delay)
        delay = 2 if lasted > 10 else min(60, delay * 2)


if __name__ == "__main__":
    sys.exit(main())
