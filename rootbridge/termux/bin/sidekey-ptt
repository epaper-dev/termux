#!/usr/bin/env python3
"""sidekey-ptt - the side key of the device as push to talk: `ptt start` on the long press, `ptt stop` on release.

BRIDGE until the E-Ink app (hisense-a9/patching) and the Termux app do this themselves. It keeps a root `cat` on the input
device of the side key alive and reads nothing else (keyreader.py). Device and key come from the device file
(SIDEKEY_DEVICE or SIDEKEY_DEVICE_NAME, SIDEKEY_CODE); without one those of the Hisense A9: /dev/input/event2 (gpio-keys),
scan code 766 = 0x2fe. Short and double presses are ignored: they stay with the E-Ink app. Set the long press of the E-Ink
app to "Nothing", or its menu opens as well.
The key of a wired headset has a reader of its own: headset-ptt.

Installed by `install.sh` when the side key is chosen (SIDEKEY=on in the rootbridge config) and started by
`rootbridge start|attach`. Runs in Termux as the Termux user; root is only the `cat` (su). Log: ~/.cache/sidekey-ptt.log
Stop it:  pkill -f sidekey-ptt        (a stray `cat` ends with the next key press)
Test hooks: SIDEKEY_CMD, SIDEKEY_PTT, SIDEKEY_LONG, SIDEKEY_ONCE, SIDEKEY_CACHE (see keyreader.py).
"""
import os
import sys

HERE = os.path.dirname(os.path.realpath(__file__))
sys.path[:0] = [os.path.join(HERE, "..", "lib", "termux-rootbridge"), os.path.join(HERE, "..", "lib")]
import keyreader  # noqa: E402  (installed next to rootbridge-lib.sh, in the repository in termux/lib)


class SideKey(keyreader.Reader):
    name, prefix, key = "sidekey-ptt", "SIDEKEY", 766   # KEY 0x2fe
    device_path = "/dev/input/event2"
    talking = False

    def on_long(self, proc):
        self.talking = True
        self.log("Langdruck: ptt start")
        self.ptt("start")

    def on_release(self, proc, was_long):
        if self.talking:
            self.log("losgelassen: ptt stop")
        self.on_end()

    def on_end(self):
        if self.talking:
            self.talking = False
            self.ptt("stop")


if __name__ == "__main__":
    sys.exit(SideKey().main())
