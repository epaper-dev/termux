#!/usr/bin/env bash
# Termux:Widget shortcut: open the Codex window of the session (the session is created if it is missing).
# Starting it also updates Claude Code and Codex (rootbridge-update), like the "Claude" widget.
# Widget shells do not read ~/.bashrc: reload the Termux settings here as well.
if command -v termux-reload-settings >/dev/null 2>&1; then termux-reload-settings; fi
exec rootbridge attach codex
